<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>

<BorderPane prefHeight="700.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ia.demoiii.controllers.MainController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
         <menus>
            <Menu text="Programa">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#showHome" text="Pradžia" />
                  <MenuItem mnemonicParsing="false" onAction="#showStudents" text="Studentų registracija" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
   </top>
   <center>
      <StackPane fx:id="contentArea" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
